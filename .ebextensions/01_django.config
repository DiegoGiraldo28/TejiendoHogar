option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings.prod
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python backend/manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python backend/manage.py collectstatic --noinput"
  03_superusuario:
    command: "source /var/app/venv/*/bin/activate && python backend/manage.py createsuperuser --noinput || true"
    leader_only: true
  04_datos_demo:
    command: "source /var/app/venv/*/bin/activate && python backend/manage.py cargar_datos_demo"
    leader_only: true